rules_version = '2';
// ═══════════════════════════════════════════════════════════════════
// FIRESTORE RULES — imfra-backend (Club VIP de IMFRA Desarrollo)
// Réplica de las reglas de IMDIIL, cambiando solo los correos admin.
//   · config/club lo LEEN sin sesión las páginas públicas que muestran
//     precios; lo ESCRIBE solo un admin desde vip-admin.html.
//   · certificados: lectura pública para que verificar.html valide folios.
//   · El webhook de Railway usa Admin SDK y NO pasa por estas reglas.
//
// Admins: teccapitalweb@gmail.com (superadmin) e imfradesarrollo@gmail.com.
//    Idénticos a ADMIN_EMAILS en vip-panel.html y ADMINS en vip-admin.html.
// ═══════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // ───────── CURSOS ─────────
    match /cursos/{cursoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── CONFIG/CLUB (precios editables) ─────────
    match /config/club {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── MIEMBROS ─────────
    match /miembros/{docId} {
      allow read: if request.auth != null &&
        (request.auth.uid == docId ||
         request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com']);
      allow create: if (request.auth != null && request.auth.uid == docId &&
                        request.resource.data.activa == false &&
                        request.resource.data.plan == null)
                    || (request.auth != null &&
                        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com']);
      allow update: if (request.auth != null &&
                        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'])
                    || (request.auth != null && request.auth.uid == docId &&
                        request.resource.data.activa == resource.data.activa &&
                        request.resource.data.plan == resource.data.plan &&
                        (!('expiraEn' in request.resource.data) ||
                         request.resource.data.expiraEn == resource.data.expiraEn));
      allow delete: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── NOTIFICACIONES ─────────
    match /notificaciones/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── MATERIALES ─────────
    match /materiales/{matId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── WEBINARS ─────────
    match /webinars/{webId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── CERTIFICADOS ─────────
    match /certificados/{folio} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ───────── NOTICIAS AUTO ─────────
    match /noticias_auto/{noticiaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'];
    }
    // ═════════ FORO ═════════
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com'] ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','likedBy','comentariosCount'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com']
      );
      match /comentarios/{comId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.uid ||
          request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com']
        );
      }
    }
    // ═════════ DIRECTORIO VIP ═════════
    match /directorio/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.email in ['teccapitalweb@gmail.com','imfradesarrollo@gmail.com']
      );
    }
    // ═════════ ENTRENAMIENTO IMFRA ═════════
    // El contenido publicado se consulta con `where('status','==','published')`.
    // Borradores, edición y eliminación son exclusivamente administrativos.
    match /training_questions/{contentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }
    match /training_cases/{contentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }
    match /training_flashcards/{contentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }
    match /training_drafts/{draftId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Progreso formativo: no contiene saldo canjeable. El alumno puede
    // sincronizar únicamente su XP, casos, tarjetas y días de actividad.
    match /training_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly([
          'uid','xpFormativo','cases','cards','days','version','updatedAt'
        ]) &&
        request.resource.data.xpFormativo is int &&
        request.resource.data.xpFormativo >= 0 &&
        request.resource.data.xpFormativo <= 100000 &&
        request.resource.data.cases is map &&
        request.resource.data.cards is map &&
        request.resource.data.days is list &&
        request.resource.data.days.size() <= 90;
      allow delete: if isAdmin();
    }

    // Intentos sirven para auditoría y analítica. El cliente puede crear el
    // suyo, pero no modificarlo después; nunca otorgan puntos por sí solos.
    match /training_attempts/{attemptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid','activityId','activityType','score','total','completedAt','version'
        ]) &&
        request.resource.data.activityId is string &&
        request.resource.data.activityType in ['quiz','case','flashcards'] &&
        request.resource.data.score is int && request.resource.data.score >= 0 &&
        request.resource.data.total is int && request.resource.data.total > 0 &&
        request.resource.data.score <= request.resource.data.total;
      allow update, delete: if isAdmin();
    }

    // ═════════ RECOMPENSAS ═════════
    match /reward_catalog/{rewardId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }
    // Cuenta y libro mayor son autoritativos: el navegador nunca escribe.
    match /reward_accounts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /reward_ledger/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /reward_redemptions/{redemptionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    // El usuario solo solicita. El servidor recalcula saldo, costo, inventario
    // y vigencia antes de crear un canje y descontar puntos.
    match /reward_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'uid','rewardId','requestKey','status','createdAt','source'
        ]) &&
        request.resource.data.rewardId is string &&
        request.resource.data.requestKey is string &&
        request.resource.data.source == 'web';
      allow update, delete: if isAdmin();
    }
    // ───────── DEFAULT ─────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
